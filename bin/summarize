#!/usr/bin/env bash

# Source shared functions
source "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/support_functions.bash"

OLLAMA_DEFAULT_MODEL=${OLLAMA_DEFAULT_MODEL:-llama3.3:70b}

show_help() {
  cat << EOF
Usage: echo "long content" | summarize [options]

Summarize content using either OpenAI's API or a local LLM (Ollama or LM Studio).

Options:
  -h, --help              Show this help message
  -md, --markdown         Format output using markdown
  -l, --local [provider]  Use a local LLM provider instead of OpenAI
                         Format: [ollama|lm_studio][:model_name]
                         Examples:
                           -l                 # defaults to ollama:$OLLAMA_DEFAULT_MODEL
                           -l ollama          # Uses default model ($OLLAMA_DEFAULT_MODEL)
                           -l ollama:mistral  # Uses specific model
                           -l lm_studio       # Uses whatever model is loaded in LM Studio

Environment Variables:
  DEBUG                 Set to any value to enable debug output
  OPENAI_API_KEY        Required for OpenAI API (default provider)
  OPENAI_MODEL          Model to use with OpenAI (default: gpt-5-mini)
  OLLAMA_DEFAULT_MODEL  Default model for Ollama (default: $OLLAMA_DEFAULT_MODEL)
  LM_STUDIO_DEFAULT_MODEL  Default model for LM Studio

Notes:
  - Local LLM providers must be running:
    - Ollama: http://localhost:11434
    - LM Studio: http://localhost:1234
  - For Ollama, models must be pulled first: ollama pull <model>
  - For LM Studio, models must be manually loaded in the UI
EOF
}

summarize() {
  local markdown=""
  local local_llm=""
  local model_name=""
  local provider=""

  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -h|--help)
        show_help
        return 0
        ;;
      -md|--markdown) markdown=", using markdown to neatly format the output," ;;
      -l|--local)
        if [[ -n "$2" && ! "$2" =~ ^- ]]; then
          local_llm="$2"
          if [[ "$local_llm" =~ ^(ollama|lm_studio):(.+)$ ]]; then
            provider="${BASH_REMATCH[1]}"
            model_name="${BASH_REMATCH[2]}"
          elif [[ "$local_llm" =~ ^(ollama|lm_studio)$ ]]; then
            provider="$local_llm"
            if [[ "$provider" == "ollama" ]]; then
              model_name="${OLLAMA_DEFAULT_MODEL:-llama3.3:70b}"
            else
              model_name="${LM_STUDIO_DEFAULT_MODEL:-mistral}"
            fi
          else
            echo "Error: Invalid local LLM format. Use 'ollama[:model]' or 'lm_studio[:model]'" >&2
            return 1
          fi
          shift
        else
          # Default to Ollama with default model if no provider specified
          provider="ollama"
          model_name="${OLLAMA_DEFAULT_MODEL:-llama3.3:70b}"
        fi
        ;;
      *)
        echo "Error: Unknown option: $1" >&2
        show_help
        return 1
        ;;
    esac
    shift
  done

  local prompt="Please summarize${markdown} the most pertinent elements of the following transcript or narrative. If it (or any part of it) presents a list of things (questions, points, tasks, steps, sequential events, etc.), please list those out without collapsing them further. If there is an issue with the content (such as it appearing to be missing), you should mention that prefixed with 'Problem: ', otherwise say nothing regarding issues (such as OpenAI usage or TOS violations). Don't comment on the summary itself. If there is a metadata section, output it verbatim${markdown} at the top of the summary, otherwise DO NOT MENTION ANYTHING about metadata!"

  local content=$(cat)

  if [[ -n "$local_llm" ]]; then
    debug "Using local LLM: $provider with model: $model_name"
    case "$provider" in
      "ollama")
        if ! validate_ollama_model "$model_name"; then
          return 1
        fi
        local payload=$(jq -n \
          --arg prompt "$prompt" \
          --arg content "$content" \
          --arg model "$model_name" \
          '{
            "model": $model,
            "messages": [{"role": "system", "content": $prompt}, {"role": "user", "content": $content}],
            "stream": false
          }'
        )
        debug "Ollama payload:"
        debug "$(echo "$payload" | jq .)"
        curl -s "http://localhost:11434/api/chat" \
          -H "Content-Type: application/json" \
          -d "$payload" \
          | jq -r '.message.content'
        ;;
      "lm_studio")
        local payload=$(jq -n \
          --arg prompt "$prompt" \
          --arg content "$content" \
          --arg model "$model_name" \
          '{
            "model": $model,
            "messages": [{"role": "system", "content": $prompt}, {"role": "user", "content": $content}],
            "stream": false
          }'
        )
        debug "LM Studio payload:"
        debug "$(echo "$payload" | jq .)"
        local response=$(curl -s "http://localhost:1234/v1/chat/completions" \
          -H "Content-Type: application/json" \
          -d "$payload")

        if ! validate_lm_studio_response "$response" "$model_name"; then
          return 1
        fi
        echo "$response" | jq -r '.choices[0].message.content'
        ;;
    esac
  else
    local api_key="${OPENAI_API_KEY}"
    local model="${OPENAI_MODEL:-gpt-5-mini}"

    local payload=$(jq -n \
      --arg prompt "$prompt" \
      --arg content "$content" \
      --arg model "$model" \
      '{
        "model": $model,
        "messages": [{"role": "system", "content": $prompt}, {"role": "user", "content": $content}]
      }'
    )

    curl -s https://api.openai.com/v1/chat/completions \
      -H "Content-Type: application/json" \
      -H "Authorization: Bearer $api_key" \
      -d "$payload" \
      | jq -r '.choices[0].message.content'
  fi
}

# Usage example:
# echo "Your content here" | summarize [-md|--markdown] [-l|--local [ollama[:model]|lm_studio[:model]]]

# Run summarize if script is executed directly
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  summarize "$@"
fi
