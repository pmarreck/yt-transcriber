# Function to invoke our Python helper
py_helper() {
  local cmd="$1"
  shift

  python3 - "$cmd" "$@" <<'PYEOF'
import sys
import json
import subprocess
from pathlib import Path

def get_audio_duration(audio_file):
    """Get exact audio duration using ffmpeg"""
    cmd = [
        'ffmpeg',
        '-i', audio_file,
        '-map', '0:a:0',  # Select first audio stream
        '-f', 'null',
        '-progress', 'pipe:1',  # Output progress to stdout
        '-'
    ]

    try:
        result = subprocess.run(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            encoding='utf-8'
        )

        # Extract the last time value from progress output
        last_time = None
        for line in result.stdout.splitlines():
            if line.startswith('out_time_us='):
                # Convert microseconds to seconds
                last_time = int(line.split('=')[1]) / 1000000

        if last_time is not None:
            return last_time

        # If we couldn't get the duration, print debug info
        print(f"Debug: ffmpeg stdout:\n{result.stdout}", file=sys.stderr)
        print(f"Debug: ffmpeg stderr:\n{result.stderr}", file=sys.stderr)
        raise ValueError("Could not determine duration from ffmpeg output")

    except Exception as e:
        print(f"Debug: Duration check failed: {str(e)}", file=sys.stderr)
        return None

def verify_durations(audio_file, expected_duration, tolerance=1.0):
    """Compare audio duration with expected duration"""
    try:
        actual_duration = get_audio_duration(audio_file)
        if actual_duration is None:
            raise ValueError("Could not get audio duration")

        diff = abs(actual_duration - float(expected_duration))
        return {
            'match': diff <= tolerance,
            'actual': actual_duration,
            'expected': float(expected_duration),
            'difference': diff,
            'method': 'ffmpeg_progress'
        }
    except Exception as e:
        print(f"Falling back to ffprobe due to: {str(e)}", file=sys.stderr)
        # Fallback to ffprobe
        cmd = ['ffprobe', '-v', 'quiet', '-show_entries', 'format=duration',
               '-of', 'default=noprint_wrappers=1:nokey=1', audio_file]
        result = subprocess.run(cmd, capture_output=True, text=True)
        actual_duration = float(result.stdout.strip())
        diff = abs(actual_duration - float(expected_duration))
        return {
            'match': diff <= tolerance,
            'actual': actual_duration,
            'expected': float(expected_duration),
            'difference': diff,
            'method': 'ffprobe_fallback'
        }

def get_video_duration(metadata_file):
    """Get video duration from metadata JSON"""
    with open(metadata_file) as f:
        return json.load(f)['duration']

if __name__ == "__main__":
    cmd = sys.argv[1]

    if cmd == "verify_duration":
        # Args: audio_file expected_duration
        result = verify_durations(sys.argv[2], sys.argv[3])
        print(json.dumps(result))

    elif cmd == "get_video_duration":
        # Args: metadata_file
        duration = get_video_duration(sys.argv[2])
        print(duration)
PYEOF
}

# Function to check if file is valid audio or video
is_valid_media() {
  local file="$1"
  local mime_type

  # Check if file exists and is a file
  if [ ! -f "$file" ]; then
    return 1
  fi

  # Use file command to check MIME type
  mime_type=$(file --mime-type -b "$file")
  debug "MIME type for $file: $mime_type"

  case "$mime_type" in
    audio/*|video/*) return 0 ;;  # Any audio or video MIME type is valid
    *)
      # Additional check with ffprobe in case MIME type is ambiguous
      if ffprobe -v quiet "$file" 2>/dev/null; then
        debug "ffprobe successfully read media file $file"
        return 0
      fi
      debug "$file is not a valid media file according to ffprobe"
      return 1
      ;;
  esac
}

# Function to handle input (either URL or file)
process_input() {
  local input="$1"
  local output_dir="$2"
  local output_file="${output_dir}/audio.mp3"

  # Check if input is a file that exists
  if [ -f "$input" ]; then
    if ! is_valid_media "$input"; then
      echo "Error: Not a valid media file: $input" >&2
      return 1
    fi
    debug "Input is a valid media file"

    # Extract/convert audio to mp3
    debug "Converting/extracting audio to mp3 format"
    if ! ffmpeg -i "$input" -vn -codec:a libmp3lame -qscale:a 2 "$output_file" -y &>/dev/null; then
      echo "Error: Failed to extract/convert audio" >&2
      return 1
    fi
    echo "Using media file: $input" >&2
    return 0
  fi

  # Not a file, treat as URL
  if ! validate_youtube_url "$input"; then
    echo "Error: Input must be either a valid media file or YouTube URL" >&2
    return 1
  fi

  # Download from YouTube
  download_audio "$input" "$output_dir"
}

# Function to check audio duration using ffprobe
get_audio_duration() {
  local audio_file="$1"
  ffprobe -v quiet -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$audio_file"
}

# Function to verify audio length
verify_audio() {
  local audio_file="$1"
  local expected_duration="$2"
  local duration_info

  duration_info=$(py_helper verify_duration "$audio_file" "$expected_duration")
  debug "Duration check result: $duration_info"

  if [[ $(echo "$duration_info" | jq -r '.match') == "true" ]]; then
    return 0
  else
    local actual
    actual=$(echo "$duration_info" | jq -r '.actual')
    echo "Warning: Audio duration (${actual}s) differs significantly from video duration (${expected_duration}s)" >&2
    return 1
  fi
}

