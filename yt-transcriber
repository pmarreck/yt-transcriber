# graceful dependency checking
needs() {
  local bin=$1
  shift
  command -v $bin > /dev/null 2>&1 || {
    printf "$SCRIPT_NAME requires %s but it's not installed or in PATH; %s\n" "$bin" "$*" 1>&2
    return 1
  }
}

# graceful (?) version checking
version() {
  local bin="$1"
  local version="$2"
  shift 2
  local instructions="$*" # optional
  # check that the version is the minimum desired based on a regex
  # ffmpeg errors but does return the version so we capture the output and return 0
  local versiondata=$($bin --version 2>&1 | head -n1)
  if ! echo "$versiondata" | grep -q "$version"; then
    printf "$SCRIPT_NAME requires %s %s but you have %s; %s\n" "$bin" "$(echo $version | tr -d '\\')" "$versiondata" "$instructions" 1>&2
    printf '%s\n' "It may work, but expected results are less guaranteed. Allowing for now." 1>&2
    return 0
  fi
}

