    if ! echo "$output" | grep -q "Working directory:"; then
      debug "Working directory line not found in output"
      echo -e "${RED}❌ Test failed: Output doesn't contain 'Working directory:' line${NC}"
      exit 1
    fi

    # Get directory and verify it exists
    work_dir=$(echo "$output" | grep "Working directory:" | cut -d':' -f2- | tr -d ' ')
    if [ -z "$work_dir" ]; then
      debug "Could not extract working directory path from output"
      echo -e "${RED}❌ Test failed: Could not extract working directory from output${NC}"
      exit 1
    fi

    assert_dir_exists "$work_dir"
  }

  # Test 5: Script downloads audio from YouTube
  test_audio_download() {
    local test_url="https://www.youtube.com/watch?v=0NfO4AAwGf4"
    local youtube_id="0NfO4AAwGf4"
    local work_dir

    # Clear any existing cached file
    rm -f "/tmp/$SCRIPT_NAME/${youtube_id}.mp3"

    # Create a working directory for this test
    work_dir=$(mktemp -d)
    debug "Created working directory for audio test: $work_dir"

    # Set mock download mode
    export MOCK_DOWNLOAD=true

    # Create mock metadata first
    cat > "${work_dir}/metadata.json" << EOF
{
  "title": "Test Video",
  "channel": "Test Channel",
  "upload_date": "20240101",
  "duration": 5.0,
  "webpage_url": "$test_url"
}
EOF

    # Run mock download directly instead of through the script
    mock_download_audio "$test_url" "$work_dir"

    # Verify the file exists and has content
    assert_file_exists "/tmp/$SCRIPT_NAME/${youtube_id}.mp3"

    # Verify it's not empty
    if [ ! -s "/tmp/$SCRIPT_NAME/${youtube_id}.mp3" ]; then
      echo -e "${RED}❌ Test failed: Downloaded file is empty${NC}"
      exit 1
    fi

    # Verify it's actually an audio file
    if ! file "/tmp/$SCRIPT_NAME/${youtube_id}.mp3" | grep -qE "Audio|audio"; then
      echo -e "${RED}❌ Test failed: File is not an audio file${NC}"
      echo "File type: $(file "/tmp/$SCRIPT_NAME/${youtube_id}.mp3")"
      exit 1
    fi

    echo -e "${GREEN}✅ Test passed: Audio file downloaded successfully${NC}"

    # Clean up
    unset MOCK_DOWNLOAD

    rm -rf "$work_dir"
  }

  # Test 6: Script uses cached audio file if available
  test_audio_cache() {
    # Setup
    local test_url="${1:-https://www.youtube.com/watch?v=0NfO4AAwGf4}"

    # Extract the YouTube ID from the URL
    local youtube_id="${test_url##*=}"  # Extract ID from URL dynamically

    local cache_dir="/tmp/$SCRIPT_NAME"
    local cache_file="$cache_dir/${youtube_id}.mp3"
    local transcript_file="$cache_dir/${youtube_id}.txt"

    # Ensure cache directory exists
    mkdir -p "$cache_dir"

    # Cleanup any existing test files
    rm -f "$cache_file" "$transcript_file"

    # Detect OS for stat command compatibility
    if [[ "$OSTYPE" == "darwin"* ]]; then
      # macOS syntax
      get_size() { /usr/bin/stat -f %z "$1"; }
      get_mtime() { /usr/bin/stat -f %m "$1"; }
    else
      # Linux syntax
      get_size() { stat -c "%s" "$1"; }
      get_mtime() { stat -c "%Y" "$1"; }
    fi

    # First run - create the cache file directly using the mock function
    debug "Creating initial cache file..."
    export MOCK_DOWNLOAD=true

    # Create a working directory for the test
    local work_dir=$(mktemp -d)
    debug "Created working directory for cache test: $work_dir"

    # Run mock download directly to create the cache file
    if ! mock_download_audio "$test_url" "$work_dir"; then
      echo "❌ Test failed: Initial download failed"
      rm -rf "$work_dir"
      unset MOCK_DOWNLOAD
      return 1
    fi

    # Verify cache file was created
    if [ ! -f "$cache_file" ]; then
      echo "❌ Test failed: Cache file was not created"
      rm -rf "$work_dir"
      unset MOCK_DOWNLOAD
      return 1
    fi

    # Get original modification time and size
    local original_mtime
    original_mtime=$(get_mtime "$cache_file")
    local original_size
    original_size=$(get_size "$cache_file")

    debug "Original cache file size: $original_size bytes"
    debug "Original modification time: $original_mtime"

    # Small delay to ensure any timestamp would change if file is modified
    sleep 1

    # Second run - should use cache
    debug "Running mock download again - should use cache..."

    # Create a new working directory for the second run
    local work_dir2=$(mktemp -d)
    debug "Created second working directory for cache test: $work_dir2"

    # Run mock download again
    if ! mock_download_audio "$test_url" "$work_dir2"; then
      echo "❌ Test failed: Second run failed"
      rm -rf "$work_dir" "$work_dir2"
      unset MOCK_DOWNLOAD
      return 1
    fi

    # Check both modification time and size
    local new_mtime
    new_mtime=$(get_mtime "$cache_file")
    local new_size
    new_size=$(get_size "$cache_file")

    debug "New cache file size: $new_size bytes"
    debug "New modification time: $new_mtime"

    # Verify file wasn't modified
    if [ "$original_mtime" -ne "$new_mtime" ]; then
        echo "❌ Test failed: Cache file was modified (timestamp changed)"
        echo "Original mtime: $original_mtime"
        echo "New mtime: $new_mtime"
        rm -rf "$work_dir" "$work_dir2"
        unset MOCK_DOWNLOAD
        return 1
    fi

    if [ "$original_size" -ne "$new_size" ]; then
        echo "❌ Test failed: Cache file size changed"
        echo "Original size: $original_size bytes"
        echo "New size: $new_size bytes"
        rm -rf "$work_dir" "$work_dir2"
        unset MOCK_DOWNLOAD
        return 1
    fi

    # Cleanup
    rm -rf "$work_dir" "$work_dir2"
    unset MOCK_DOWNLOAD

    echo "✅ Test passed: Cache file was used without modification"
    return 0
  }

  # Test 7: Script generates transcript from audio
  test_transcription() {
    # Skip this test if we're running integration tests to avoid recursion
    if [ "${INTEGRATION_TEST:-false}" = "true" ]; then
      echo -e "${YELLOW}Skipping transcription test in integration test mode${NC}"
      return 0
    fi

    local test_url="https://www.youtube.com/watch?v=0NfO4AAwGf4"
    local youtube_id="0NfO4AAwGf4"
    local work_dir

    # Run the script and capture its output to get the working directory
    local output
    output=$(TEST=false INTEGRATION_TEST= INTEGRATION_TEST_DEPS_ONLY= DEBUG= "$SCRIPT_NAME" "$test_url" 2>&1 || true)

    # Extract working directory from output
    work_dir=$(echo "$output" | grep "Working directory:" | cut -d':' -f2- | tr -d ' ')
    if [ -z "$work_dir" ]; then
      echo "❌ Test failed: Could not determine working directory"
      echo "Script output:"
      echo "$output"
      exit 1
    fi

    # Check for transcript file in the script's working directory
    local transcript_file="${work_dir}/transcript.txt"
    assert_file_exists "$transcript_file"

    # Check that transcript has content
    if [ ! -s "$transcript_file" ]; then
      echo "❌ Test failed: Transcript file is empty"
      exit 1
    fi

    # Check that transcript contains actual text (not just whitespace or garbage)
    if ! grep -q '[[:alpha:]]' "$transcript_file"; then
      echo "❌ Test failed: Transcript doesn't contain readable text"
      echo "Transcript content:"
      cat "$transcript_file"
      exit 1
    fi

    echo "✅ Test passed: Generated valid transcript"
  }

  # Test that Rye environment properly activates dependencies
  test_rye_dependencies() {
    echo -e "${BLUE}Verifying Rye environment and dependencies...${NC}"

    # Setup Python environment using the actual function
    echo -e "${YELLOW}Setting up Python environment...${NC}"
    setup_python_env
    echo -e "${GREEN}Python environment setup completed${NC}"

    # Check that critical dependencies are available
    local dependencies=("python" "yt-dlp" "ffmpeg")
    local missing_deps=()

    for dep in "${dependencies[@]}"; do
      echo -n "Checking for $dep: "
      if command -v "$dep" >/dev/null 2>&1; then
        echo -e "${GREEN}Found${NC}"

        # For Python dependencies, verify they can be imported
        if [ "$dep" = "python" ]; then
          echo "Python version: $(python --version)"

          # Check critical Python packages
          local py_packages=("torch" "whisper" "yt_dlp" "psutil")
          for pkg in "${py_packages[@]}"; do
            echo -n "  Checking Python package $pkg: "
            if python -c "import $pkg" 2>/dev/null; then
              echo -e "${GREEN}Installed${NC}"

              # For torch, check if MPS (Metal Performance Shaders) is available on macOS
              if [ "$pkg" = "torch" ] && [[ "$OSTYPE" == "darwin"* ]]; then
                echo -n "    MPS available: "
                if python -c "import torch; print(torch.backends.mps.is_available())" 2>/dev/null | grep -q "True"; then
                  echo -e "${GREEN}Yes${NC}"
                else
                  echo -e "${YELLOW}No${NC}"
                fi
              fi
            else
              echo -e "${RED}Not installed${NC}"
              missing_deps+=("Python package: $pkg")
            fi
          done
        fi

        # For yt-dlp, check version
        if [ "$dep" = "yt-dlp" ]; then
          echo "yt-dlp version: $(yt-dlp --version)"
        fi

        # For ffmpeg, check version
        if [ "$dep" = "ffmpeg" ]; then
          echo "ffmpeg version: $(ffmpeg -version | head -n 1)"
        fi
      else
        echo -e "${RED}Not found${NC}"
        missing_deps+=("$dep")
      fi
    done

    # Report missing dependencies
    if [ ${#missing_deps[@]} -gt 0 ]; then
      echo -e "${RED}❌ Dependency verification failed. Missing dependencies:${NC}"
      for missing in "${missing_deps[@]}"; do
        echo -e "${RED}- $missing${NC}"
      done

      echo -e "${YELLOW}Debugging information:${NC}"
      echo "PATH: $PATH"
      echo "RYE_PROJECT_DIR: $RYE_PROJECT_DIR"

      if [ -d "$RYE_PROJECT_DIR/.venv" ]; then
        echo -e "${YELLOW}Rye virtual environment exists at: $RYE_PROJECT_DIR/.venv${NC}"
        ls -la "$RYE_PROJECT_DIR/.venv/bin" 2>/dev/null || echo "Cannot list .venv/bin contents"
      else
        echo -e "${RED}Rye virtual environment not found at: $RYE_PROJECT_DIR/.venv${NC}"
      fi

      return 1
    fi

    echo -e "${GREEN}✅ All dependencies verified successfully${NC}"
    return 0
  }
  # Integration test: Test with real YouTube URL and dependencies
  test_integration() {
    echo -e "${YELLOW}Running integration test with real YouTube URL and dependencies${NC}"

    # First verify dependencies
    test_rye_dependencies

    local test_url="${INTEGRATION_TEST_URL:-https://www.youtube.com/watch?v=jNQXAC9IVRw}"

    # Extract the YouTube ID from the URL
    local youtube_id=$(echo "$test_url" | sed -n 's/.*[?&]v=\([^&]*\).*/\1/p')
    if [ -z "$youtube_id" ]; then
      echo -e "${RED}❌ Integration test failed: Could not extract YouTube ID from URL: $test_url${NC}"
      return 1
    fi

    local cache_dir="/tmp/$SCRIPT_NAME"
    local cache_file="$cache_dir/${youtube_id}.mp3"
    local transcript_file="$cache_dir/${youtube_id}.txt"

    # Clean up any existing files if INTEGRATION_TEST_CLEAN is set
    if [ "${INTEGRATION_TEST_CLEAN:-true}" = "true" ]; then
      echo -e "${YELLOW}Cleaning up existing test files...${NC}"
      rm -f "$cache_file" "$transcript_file"
    else
      echo -e "${YELLOW}Skipping cleanup of existing test files...${NC}"
    fi

    # Create the cache directory if it doesn't exist
    mkdir -p "$cache_dir"

    # Run the actual script with the real URL
    echo -e "${YELLOW}Downloading and transcribing real YouTube video...${NC}"
    echo -e "${YELLOW}This may take a few minutes depending on your internet connection and CPU.${NC}"

    # First, validate the URL separately to avoid issues with argument parsing
    echo -e "${YELLOW}Validating YouTube URL: $test_url${NC}"
    if ! validate_youtube_url "$test_url"; then
      echo -e "${RED}❌ Integration test failed: Invalid YouTube URL: $test_url${NC}"
      return 1
    fi

    # Define command arguments as an array to properly handle spaces and flags
    local cmd_args=()
    cmd_args+=("$test_url")

    # Add any additional arguments from environment variable
    if [ -n "${INTEGRATION_TEST_ARGS:-}" ]; then
      # Split the args string into an array
      IFS=' ' read -r -a extra_args <<< "$INTEGRATION_TEST_ARGS"
      cmd_args+=("${extra_args[@]}")
    fi

    # Run the script directly
    echo -e "${YELLOW}Running command: $SCRIPT_NAME ${cmd_args[*]}${NC}"

    # Create a variable to capture the temporary directory
    local temp_dir=""

    # Temporary file to capture stderr
    local stderr_file=$(mktemp)

    # Run the script with DEBUG=true to capture the working directory
    cd "$SCRIPT_DIR"
    TEST=false INTEGRATION_TEST= INTEGRATION_TEST_DEPS_ONLY= DEBUG=true "$SCRIPT_NAME" "${cmd_args[@]}" 2> "$stderr_file"
    local exit_code=$?

    # Extract the working directory from stderr
    if grep -q "^Working directory: " "$stderr_file"; then
      temp_dir=$(grep "^Working directory: " "$stderr_file" | head -n 1 | sed 's/^Working directory: //')
    fi

    # Display stderr for debugging
    cat "$stderr_file" >&2
    rm -f "$stderr_file"

    if [ $exit_code -ne 0 ]; then
      echo -e "${RED}❌ Integration test failed: Script exited with code $exit_code${NC}"
      return 1
    fi

    # Wait a moment for file operations to complete
    sleep 2

    # Check if we captured the temporary directory
    if [ -z "$temp_dir" ]; then
      echo -e "${RED}❌ Integration test failed: Could not determine temporary working directory${NC}"
      return 1
    fi

    echo -e "${YELLOW}Temporary working directory: $temp_dir${NC}"

    # Check if the cache directory exists
    if [ ! -d "$cache_dir" ]; then
      echo -e "${RED}❌ Integration test failed: Cache directory was not created${NC}"
      echo "Expected directory: $cache_dir"
      return 1
    fi

    # List the contents of the cache directory for debugging
    echo -e "${YELLOW}Cache directory contents:${NC}"
    ls -la "$cache_dir"

    # List the contents of the temporary directory
    echo -e "${YELLOW}Temporary directory contents:${NC}"
    ls -la "$temp_dir"

    # Verify the audio file was downloaded to cache
    if [ ! -f "$cache_file" ]; then
      echo -e "${RED}❌ Integration test failed: Audio file was not downloaded to cache${NC}"
      echo "Expected file: $cache_file"
      return 1
    fi

    # Verify it's actually an audio file
    if ! file "$cache_file" | grep -qE "Audio|audio"; then
      echo -e "${RED}❌ Integration test failed: File is not an audio file${NC}"
      echo "File type: $(file "$cache_file")"
      return 1
    fi

    # Verify the transcript was generated in the temporary directory
    local transcript_file="$temp_dir/transcript.txt"
    if [ ! -f "$transcript_file" ]; then
      echo -e "${RED}❌ Integration test failed: Transcript file was not generated${NC}"
      echo "Expected file: $transcript_file"
      return 1
    fi

    # Verify the transcript has content
    if [ ! -s "$transcript_file" ]; then
      echo -e "${RED}❌ Integration test failed: Transcript file is empty${NC}"
      echo "Expected file: $transcript_file"
      return 1
    fi

    # Display some of the transcript content
    echo -e "${YELLOW}Transcript preview:${NC}"
    head -n 5 "$transcript_file"
    echo "..."

    echo -e "${GREEN}✅ Integration test passed: Successfully downloaded and transcribed a real YouTube video${NC}"
    return 0
  }

  # Ensure tests run in correct order
  echo -e "${YELLOW}Running YT Transcriber tests...${NC}"
  dependencychecks
  versionchecks
  run_test "Script exists and executable" test_script_exists
  run_test "Usage message" test_usage
  run_test "URL validation" test_url_validation
  run_test "Working directory creation" test_working_dir

  if [ "$INTEGRATION_TEST" = "true" ]; then
    echo -e "${BLUE}Running in INTEGRATION TEST mode with real dependencies${NC}"

    # Run dependency verification first
    if [ "${INTEGRATION_TEST_DEPS_ONLY:-false}" = "true" ]; then
      # Only run dependency verification
      run_test "Rye dependency verification" test_rye_dependencies
    else
      # Run both dependency verification and full integration test
      run_test "Rye dependency verification" test_rye_dependencies
      run_test "Integration test" test_integration
    fi
  else
    echo -e "${BLUE}Running in MOCK TEST mode${NC}"
    run_test "Audio download" test_audio_download
    run_test "Audio caching" test_audio_cache
  fi

  echo -e "${GREEN}All tests passed!${NC}"

else # This file was run directly
  # If this file is run directly and not sourced, call the function with any argv's provided
  if [[ "$*" == *"--test"* ]] || [[ "$*" == *"TEST"* ]]; then
    # Run in test mode (using mocks)
    TEST=true
    INTEGRATION_TEST=false
    (return 0 2>/dev/null) || main "$@" 2>&1 | filter_warnings
  elif [[ "$*" == *"--integration-test"* ]]; then
    # Run integration tests (using real services)
    TEST=true
    INTEGRATION_TEST=true
    (return 0 2>/dev/null) || main "$@" 2>&1 | filter_warnings
  else
    # Normal operation (also filter warnings by default)
    (return 0 2>/dev/null) || main "$@" 2>&1 | filter_warnings
  fi
fi


