filter_warnings() {
  if [ "${SHOW_YOUTUBE_WARNINGS:-false}" == "true" ]; then
    # If showing warnings, just pass through
    cat
  else
    # Default: filter out WARNING lines and their indented continuations
    awk '
      /WARNING: \[youtube\].*nsig extraction failed/ { 
        in_warning = 1; 
        next; 
      } 
      in_warning && /^ +/ { 
        next; 
      } 
      { 
        in_warning = 0; 
