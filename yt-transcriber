# Function to check audio duration using ffprobe
get_audio_duration() {
  local audio_file="$1"
  ffprobe -v quiet -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$audio_file"
}

# Function to verify audio length
verify_audio() {
  local audio_file="$1"
  local expected_duration="$2"
  local duration_info

  duration_info=$(py_verify_duration "$audio_file" "$expected_duration")
  debug "Duration check result: $duration_info"

  if [[ $(echo "$duration_info" | jq -r '.match') == "true" ]]; then
    return 0
  else
    local actual
    actual=$(echo "$duration_info" | jq -r '.actual')
    echo "Warning: Audio duration (${actual}s) differs significantly from video duration (${expected_duration}s)" >&2
    return 1
  fi
}

# Function for duration verification
py_verify_duration() {
  if ! python - "$audio_file" "$expected_duration" <<'EOF'
import sys
import json
import subprocess

def get_audio_duration(audio_file):
    """Get exact audio duration using ffmpeg"""
    cmd = [
        'ffmpeg',
        '-i', audio_file,
        '-map', '0:a:0',  # Select first audio stream
        '-f', 'null',
        '-progress', 'pipe:1',  # Output progress to stdout
        '-'
    ]

    try:
        result = subprocess.run(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            encoding='utf-8'
        )

        # Extract the last time value from progress output
        last_time = None
        for line in result.stdout.splitlines():
            if line.startswith('out_time_us='):
                # Convert microseconds to seconds
                last_time = int(line.split('=')[1]) / 1000000

        if last_time is not None:
            return last_time

        # If we couldn't get the duration, print debug info
        print(f"Debug: ffmpeg stdout:\n{result.stdout}", file=sys.stderr)
        print(f"Debug: ffmpeg stderr:\n{result.stderr}", file=sys.stderr)
        raise ValueError("Could not determine duration from ffmpeg output")

    except Exception as e:
        print(f"Debug: Duration check failed: {str(e)}", file=sys.stderr)
        return None

def verify_durations(audio_file, expected_duration, tolerance=1.0):
    """Compare audio duration with expected duration"""
    try:
        actual_duration = get_audio_duration(audio_file)
        if actual_duration is None:
            raise ValueError("Could not get audio duration")

        diff = abs(actual_duration - float(expected_duration))
        return {
            'match': diff <= tolerance,
            'actual': actual_duration,
            'expected': float(expected_duration),
            'difference': diff,
            'method': 'ffmpeg_progress'
        }
    except Exception as e:
        print(f"Falling back to ffprobe due to: {str(e)}", file=sys.stderr)
        # Fallback to ffprobe
        cmd = ['ffprobe', '-v', 'quiet', '-show_entries', 'format=duration',
               '-of', 'default=noprint_wrappers=1:nokey=1', audio_file]
        result = subprocess.run(cmd, capture_output=True, text=True)
        actual_duration = float(result.stdout.strip())
        diff = abs(actual_duration - float(expected_duration))
        return {
            'match': diff <= tolerance,
            'actual': actual_duration,
            'expected': float(expected_duration),
            'difference': diff,
            'method': 'ffprobe_fallback'
        }

if __name__ == "__main__":
    result = verify_durations(sys.argv[1], sys.argv[2])
    print(json.dumps(result))
EOF
  then
    echo "Error: Duration verification failed" >&2
    return 1
  fi
}

