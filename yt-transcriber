# Function to get file modification time in a cross-platform way
get_file_mtime() {
  local file="$1"
  if [[ "$OSTYPE" == "darwin"* ]]; then
    # macOS version
    stat -f "%m" "$file"
  else
    # Linux version
    stat -c "%Y" "$file"
  fi
}

# Create a safe temporary directory
create_safe_tempdir() {
  local temp_dir

  # Create temp directory with mktemp
  temp_dir=$(mktemp -d 2>/dev/null || mktemp -d -t 'yttmp')
  debug "mktemp created directory: $temp_dir"

  if [ ! -d "$temp_dir" ]; then
    echo "Error: Failed to create temporary directory" >&2
    exit 1
  fi

  # Just ensure it's an absolute path and not any of our forbidden paths
  if [[ "$temp_dir" = "/" ]] || [[ "$temp_dir" = "$HOME" ]] || [[ ! "$temp_dir" = /* ]]; then
    debug "ERROR: Unsafe temporary directory path: $temp_dir"
    echo "Error: Unsafe temporary directory '$temp_dir' created" >&2
    exit 1
  fi

  # Set restrictive permissions
  chmod 700 "$temp_dir"

  echo "$temp_dir"
}

# Function to validate YouTube URL
validate_youtube_url() {
  local url="$1"
  local sanitized_url

  if ! sanitized_url=$(sanitize_youtube_url "$url"); then
    echo "Invalid YouTube URL" >&2
    return 1
  fi

  if ! get_youtube_id "$sanitized_url" > /dev/null; then
    echo "Could not extract YouTube ID" >&2
    return 1
  fi

  return 0
}

# Function to sanitize YouTube URL to canonical form with only v= parameter
sanitize_youtube_url() {
  local url="$1"
  local clean_url

  # Convert youtu.be URLs to youtube.com format first
  if [[ $url =~ ^https?://[^/]*youtu\.be/([^?&#]+) ]]; then
    clean_url="https://youtube.com/watch?v=${BASH_REMATCH[1]}"
  elif [[ $url =~ ^https?://[^/]*youtube\.com/watch ]]; then
    # Extract the v parameter
    if [[ $url =~ [?\&]v=([^&#]+) ]]; then
      clean_url="https://youtube.com/watch?v=${BASH_REMATCH[1]}"
    else
      return 1
    fi
  else
    return 1
  fi

  echo "$clean_url"
}

# Function to extract just the YouTube ID from a sanitized URL
get_youtube_id() {
  local url="$1"

  # We expect a clean URL in the form https://youtube.com/watch?v=ID
  if [[ $url =~ [?\&]v=([^&#]+) ]]; then
    echo "${BASH_REMATCH[1]}"
    return 0
  fi

  return 1
}

