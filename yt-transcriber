# Function to set up Python environment
setup_python_env() {
  debug "Setting up Python environment..."

  # Check if Rye is available
  if ! command -v rye >/dev/null 2>&1; then
    echo "Error: Rye not found in PATH. This script requires Rye for dependency management." >&2
    echo "Please ensure Rye is installed and available in your PATH." >&2
    return 1
  fi

  debug "Rye found in PATH, using Rye for dependency management"

  # RYE_PROJECT_DIR is already defined globally at the top of the script
  debug "Project directory: $RYE_PROJECT_DIR"

  # Create project directory if it doesn't exist
  mkdir -p "$RYE_PROJECT_DIR"

  # Create a minimal Python module structure
  mkdir -p "$RYE_PROJECT_DIR/yt_transcriber_deps"
  if [ ! -f "$RYE_PROJECT_DIR/yt_transcriber_deps/__init__.py" ]; then
    debug "Creating minimal Python module structure"
    echo "# yt-transcriber dependencies module" > "$RYE_PROJECT_DIR/yt_transcriber_deps/__init__.py"
  fi

  # Create pyproject.toml if it doesn't exist
  if [ ! -f "$RYE_PROJECT_DIR/pyproject.toml" ]; then
    debug "Creating pyproject.toml in $RYE_PROJECT_DIR"

    # Create pyproject.toml with our dependencies
    cat > "$RYE_PROJECT_DIR/pyproject.toml" << EOF
[project]
name = "yt-transcriber-deps"
version = "0.1.0"
description = "Dependencies for YouTube transcriber using Whisper"
requires-python = ">=3.12"
dependencies = [
    "torch",
    "torchvision",
    "torchaudio",
    "openai-whisper",
    "yt-dlp",
    "psutil",
]

[tool.rye]
managed = true
dev-dependencies = []

[tool.hatch.build.targets.wheel]
packages = ["yt_transcriber_deps"]
EOF
  fi

  # Create empty lockfiles if they don't exist to avoid Rye warnings
  if [ ! -f "$RYE_PROJECT_DIR/requirements.lock" ]; then
    debug "Creating empty requirements.lock file"
    touch "$RYE_PROJECT_DIR/requirements.lock"
  fi

  if [ ! -f "$RYE_PROJECT_DIR/requirements-dev.lock" ]; then
    debug "Creating empty requirements-dev.lock file"
    touch "$RYE_PROJECT_DIR/requirements-dev.lock"
  fi

  # Initialize Rye project if not already initialized
  if [ ! -d "$RYE_PROJECT_DIR/.venv" ]; then
    debug "Initializing Rye project..."

    # We need to run Rye commands from the project directory
    local current_dir="$(pwd)"
    cd "$RYE_PROJECT_DIR" || {
      echo "Error: Failed to change to project directory" >&2
      return 1
    }

    # Initialize Rye project with --no-pin to avoid Python version pinning issues
    if ! rye init --existing --no-pin; then
      echo "Error: Failed to initialize Rye project" >&2
      cd "$current_dir"
      return 1
    fi

    # Sync dependencies with uv backend
    debug "Syncing Rye dependencies with uv backend..."
    if ! rye sync --no-lock; then
      echo "Error: Failed to sync Rye dependencies" >&2
      cd "$current_dir"
      return 1
    fi

    # Return to original directory
    cd "$current_dir"

    debug "Rye project initialized and dependencies synced"
  fi

  # Activate the Rye environment
  if [ -f "$RYE_PROJECT_DIR/.venv/bin/activate" ]; then
    debug "Activating Rye environment..."
    source "$RYE_PROJECT_DIR/.venv/bin/activate"
    debug "Activated Rye environment"
  else
    echo "Error: Rye environment activation script not found" >&2
    return 1
  fi

  # Verify critical packages are installed
  if ! python -c "import torch, whisper, yt_dlp" 2>/dev/null; then
    debug "Some required packages are missing, reinstalling..."

    # Try with uv first if available
    if command -v uv >/dev/null 2>&1; then
      debug "Installing dependencies with uv..."
      uv pip install torch torchvision torchaudio openai-whisper yt-dlp psutil
    else
      debug "Installing dependencies with pip..."
      pip install --disable-pip-version-check torch torchvision torchaudio openai-whisper yt-dlp psutil
    fi
  else
    debug "All required packages are installed"
  fi

  # Display environment info
  debug "Python environment ready!"
  debug "Python: $(python --version 2>&1)"

  # Check torch
  if python -c "import torch" 2>/dev/null; then
    debug "Torch: $(python -c "import torch; print(f'PyTorch {torch.__version__}')")"
    debug "MPS available: $(python -c "import torch; print(torch.backends.mps.is_available())")"
  else
    debug "Torch: Not available"
    debug "MPS available: False"
  fi

  # Add Rye environment bin to PATH
  export PATH="$RYE_PROJECT_DIR/.venv/bin:$PATH"
  debug "Updated PATH with Rye environment bin: $RYE_PROJECT_DIR/.venv/bin"

  # Verify critical commands are available
  if command -v yt-dlp >/dev/null 2>&1; then
    debug "yt-dlp is available in PATH"
  else
    debug "WARNING: yt-dlp is NOT available in PATH"
    debug "Current PATH: $PATH"
    if [ -f "$RYE_PROJECT_DIR/.venv/bin/yt-dlp" ]; then
      debug "yt-dlp exists in Rye environment but is not in PATH"
      # Force symlink yt-dlp to a location in PATH
      ln -sf "$RYE_PROJECT_DIR/.venv/bin/yt-dlp" "/tmp/yt-dlp"
      export PATH="/tmp:$PATH"
      debug "Created symlink to yt-dlp in /tmp and added to PATH"
    else
      debug "yt-dlp does not exist in Rye environment, attempting direct installation"
      if command -v uv >/dev/null 2>&1; then
        debug "Installing yt-dlp with uv..."
        uv pip install yt-dlp
      else
        debug "Installing yt-dlp with pip..."
        pip install --disable-pip-version-check yt-dlp
      fi
    fi
  fi
}

# Function to install required Python packages
install_python_packages() {
  # Ensure we're in the virtual environment
  if [ -f "$RYE_PROJECT_DIR/.venv/bin/activate" ]; then
    source "$RYE_PROJECT_DIR/.venv/bin/activate"
  fi

  # All packages should be managed through Rye and pyproject.toml
  debug "Packages should already be installed by setup_python_env using Rye"

  # Verify that critical packages are available
  if ! python -c "import torch" 2>/dev/null || \
     ! python -c "import whisper" 2>/dev/null || \
     ! python -c "import yt_dlp" 2>/dev/null; then
    debug "Some packages are missing, attempting to sync again with Rye"
    (cd "$RYE_PROJECT_DIR" && rye sync)
  fi

  return 0
}

# Function to invoke our Python helper
python_transcribe() {
  if ! python - "$audio_file" "$transcript_file" "$model" "$metadata_file" <<'EOF'
import sys
import json
import warnings
import time
import torch
from datetime import datetime
import psutil
import os

# Try different import approaches for whisper
try:
    import whisper
except ImportError:
    try:
        import openai.whisper as whisper
    except ImportError:
        # Final fallback
        from openai import whisper

def get_system_info():
    return {
        'cpu_cores': psutil.cpu_count(logical=False),
        'cpu_threads': psutil.cpu_count(logical=True),
        'memory_gb': psutil.virtual_memory().total / (1024**3)
    }

def format_duration(seconds):
    minutes, seconds = divmod(int(seconds), 60)
    hours, minutes = divmod(minutes, 60)
    if hours > 0:
        return f"{hours}:{minutes:02d}:{seconds:02d}"
    return f"{minutes}:{seconds:02d}"

def transcribe(audio_file, output_file, model_name, metadata_file):
    # Filter out warnings
    warnings.filterwarnings("ignore", category=FutureWarning, module="whisper")
    warnings.filterwarnings("ignore", category=UserWarning)

    # System info
    sys_info = get_system_info()
    print("\n=== System Information ===", file=sys.stderr)
    print(f"CPU Cores: {sys_info['cpu_cores']}", file=sys.stderr)
    print(f"CPU Threads: {sys_info['cpu_threads']}", file=sys.stderr)
    print(f"Memory: {sys_info['memory_gb']:.1f}GB", file=sys.stderr)
    print(f"PyTorch version: {torch.__version__}", file=sys.stderr)
    print(f"PyTorch CUDA available: {torch.cuda.is_available()}", file=sys.stderr)
    print(f"MPS available: {torch.backends.mps.is_available()}", file=sys.stderr)
    print(f"MPS built: {torch.backends.mps.is_built()}", file=sys.stderr)

    # Try to load metadata, use empty dict if file doesn't exist
    try:
        with open(metadata_file) as f:
            metadata = json.load(f)
    except (FileNotFoundError, json.JSONDecodeError) as e:
        print(f"\nWarning: Could not load metadata file: {str(e)}", file=sys.stderr)
        print("Continuing without metadata...", file=sys.stderr)
        metadata = {
            'title': 'Unknown',
            'channel': 'Unknown',
            'upload_date': 'Unknown',
            'duration': 0,
            'webpage_url': 'Unknown'
        }

    # Try to enable MPS
    humanized_device = "CPU"
    try:
        if torch.backends.mps.is_available():
            print("\nAttempting to use Metal acceleration...", file=sys.stderr)
            device = torch.device("mps")
            # Create a small tensor to test MPS
            test_tensor = torch.ones(1).to(device)
            print("✓ Metal acceleration enabled", file=sys.stderr)
            humanized_device = "GPU"
        else:
            device = torch.device("cpu")
            print("\nFalling back to CPU only", file=sys.stderr)
    except Exception as e:
        device = torch.device("cpu")
        print(f"\nError setting up Metal: {str(e)}", file=sys.stderr)
        print("Falling back to CPU", file=sys.stderr)

    # Print model info to stderr
    cache_dir = os.path.expanduser("~/.cache/whisper")
    print(f"Model stored in: {cache_dir}", file=sys.stderr)
    model_size = os.path.getsize(os.path.join(cache_dir, f"{model_name}.pt")) / 1024 / 1024
    print(f"Model size: {model_size:.1f}MB", file=sys.stderr)

    # Load model and transcribe
    print(f"Loading {model_name} model into {humanized_device}...", file=sys.stderr)
    model = whisper.load_model(model_name)
    print(f"Model loaded, transcribing...", file=sys.stderr)

    # Time the transcription
    start_time = time.time()

    result = model.transcribe(
        audio_file,
        fp16=False
    )

    end_time = time.time()
    duration = end_time - start_time
    print(f"Transcription completed in {duration:.2f} seconds", file=sys.stderr)

    transcript = result["text"].strip()

    # Write complete output (metadata + transcript) to stdout
    output = (
        f"=== Video Metadata ===\n"
        f"Title: {metadata['title']}\n"
        f"Channel: {metadata['channel']}\n"
        f"Upload Date: {metadata['upload_date']}\n"
        f"Duration: {format_duration(metadata['duration'])}\n"
        f"URL: {metadata['webpage_url']}\n"
        f"=== Transcript ===\n\n"
        f"{transcript}\n"
    )

    with open(output_file, 'w') as f:
        f.write(output)

    print(output)

if __name__ == "__main__":
    transcribe(sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4])
EOF
  then
    echo "Error: Transcription failed" >&2
    return 1
  fi
}

# Function to check if file is valid audio or video
is_valid_media() {
  local file="$1"
  local mime_type

  # Check if file exists and is a file
  if [ ! -f "$file" ]; then
    return 1
  fi

  # Use file command to check MIME type
  mime_type=$(file --mime-type -b "$file")
  debug "MIME type for $file: $mime_type"

  case "$mime_type" in
    audio/*|video/*) return 0 ;;  # Any audio or video MIME type is valid
    *)
      # Additional check with ffprobe in case MIME type is ambiguous
      if ffprobe -v quiet "$file" 2>/dev/null; then
        debug "ffprobe successfully read media file $file"
        return 0
      fi
      debug "$file is not a valid media file according to ffprobe"
      return 1
      ;;
  esac
}

# Function to handle input (either URL or file)
process_input() {
  local input="$1"
  local output_dir="$2"
  local output_file="${output_dir}/audio.mp3"

  # Check if input is a file that exists
  if [ -f "$input" ]; then
    if ! is_valid_media "$input"; then
      echo "Error: Not a valid media file: $input" >&2
      return 1
    fi
    debug "Input is a valid media file"

    # Extract/convert audio to mp3
    debug "Converting/extracting audio to mp3 format"
    if ! ffmpeg -i "$input" -vn -codec:a libmp3lame -qscale:a 2 "$output_file" -y &>/dev/null; then
      echo "Error: Failed to extract/convert audio" >&2
      return 1
    fi
    echo "Using media file: $input" >&2
    return 0
  fi

  # Not a file, treat as URL
