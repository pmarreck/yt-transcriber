    # Try to load metadata, use empty dict if file doesn't exist
    try:
        with open(metadata_file) as f:
            metadata = json.load(f)
    except (FileNotFoundError, json.JSONDecodeError) as e:
        print(f"\nWarning: Could not load metadata file: {str(e)}", file=sys.stderr)
        print("Continuing without metadata...", file=sys.stderr)
        metadata = {
            'title': 'Unknown',
            'channel': 'Unknown',
            'upload_date': 'Unknown',
            'duration': 0,
            'webpage_url': 'Unknown'
        }

    # Try to enable MPS
    humanized_device = "CPU"
    try:
        if torch.backends.mps.is_available():
