# Function to set up Python environment
setup_python_env() {
  # Set up virtual environment if it doesn't exist
  # Since we might install and run this command from anywhere, we will use an appropriate XDG directory

  if [ ! -d "$VENV_DIR" ]; then
    echo "Creating new Python virtual environment in $VENV_DIR..."
    mkdir -p "$VENV_DIR"
    python3 -m venv "$VENV_DIR"
  fi

  # Activate virtual environment
  source "$VENV_DIR/bin/activate"

  # Install Python packages imperatively if needed
  # We do this outside of Nix because unfortunately this is the most supported/reliable way at this time
  if [ ! -f "$VENV_DIR/.packages-installed" ]; then
    echo "Installing Python packages..."
    python3 -m pip install --upgrade pip
    python3 -m pip install torch torchvision torchaudio
    python3 -m pip install openai-whisper
    python3 -m pip install psutil
    # Mark packages as installed
    touch "$VENV_DIR/.packages-installed"
  fi

  debug "Whisper environment ready with MPS support!"
  debug "Python: $(python3 --version)"
  debug "Torch: $(python3 -c 'import torch; print(f"PyTorch {torch.__version__}")')"
  debug "MPS available: $(python3 -c 'import torch; print(torch.backends.mps.is_available())')"

  # Add .venv/bin to PATH
  export PATH="$VENV_DIR/bin:$PATH"
  source $VENV_DIR/bin/activate
}

